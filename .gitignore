```gitignore
# ============================================================
# FLOODSIGHT - GITIGNORE
# ============================================================


# -------------------- Python --------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python


# -------------------- Virtual Environments --------------------
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/


# -------------------- Environment Variables / Secrets --------------------
.env
.env.*
!.env.example

*.pem
*.key
credentials.json
service-account*.json
earthengine-credentials/

.credentials/
.gcloud/


# -------------------- Distribution / Packaging --------------------
build/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
*.manifest
*.spec


# -------------------- Installer Logs --------------------
pip-log.txt
pip-delete-this-directory.txt


# -------------------- Testing / Coverage --------------------
.pytest_cache/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover
cover/


# -------------------- Type Checking / Linters --------------------
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/
cython_debug/


# -------------------- Jupyter / IPython --------------------
.ipynb_checkpoints/
profile_default/
ipython_config.py


# -------------------- Data: FloodSight --------------------
# Raw satellite imagery and downloaded datasets
data/raw/

# Intermediate processing outputs
data/interim/

# Processed datasets and generated splits
data/processed/

# External datasets (WorldPop, WorldCover, etc.)
data/external/

# Preserve empty data directories using .gitkeep files
# Re-include parent directories so Git can see the .gitkeep files
!data/
!data/raw/
!data/raw/.gitkeep
!data/interim/
!data/interim/.gitkeep
!data/processed/
!data/processed/.gitkeep
!data/external/
!data/external/.gitkeep


# -------------------- Large Geospatial Data --------------------
*.tif
*.tiff
*.vrt
*.img
*.jp2
*.grd
*.nc
*.h5
*.hdf5
*.zarr/

# Geospatial sidecar and temporary files
*.aux.xml
*.ovr
*.tfw
*.jgw
*.wld
*.qix
*.gpkg-wal
*.gpkg-shm
*.shp.xml
*.lock


# -------------------- Additional Large Dataset Files --------------------
*.zip
*.gz
*.jsonl
*.jsonl.gz
*.parquet
*.feather
*.arrow
*.npy
*.npz
*.pkl
*.pickle
*.joblib


# -------------------- Model Checkpoints and Weights --------------------
models/checkpoints/
models/*.pth
models/*.pt
models/*.ckpt
models/*.onnx
models/*.safetensors

# Also exclude model files in nested model directories
models/**/*.pth
models/**/*.pt
models/**/*.ckpt
models/**/*.onnx
models/**/*.safetensors

# Additional model formats
*.keras


# -------------------- Experiment Tracking --------------------
mlruns/
mlartifacts/
experiments/runs/
experiments/logs/
lightning_logs/
wandb/
tensorboard/


# -------------------- Generated Reports --------------------
reports/generated/
reports/tmp/


# -------------------- Streamlit --------------------
.streamlit/secrets.toml


# -------------------- IDE / Editors --------------------
.vscode/
.idea/
.spyderproject
.spyproject
.ropeproject
.cursorindexingignore


# -------------------- Operating System --------------------
.DS_Store
Thumbs.db
desktop.ini


# -------------------- Miscellaneous --------------------
*.log
*.tmp
*.bak
*.swp
*.swo
*~
